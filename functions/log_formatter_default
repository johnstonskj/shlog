# -*- mode: sh; eval: (sh-set-shell "zsh") -*-

emulate -L zsh

color_muted
printf '%s ' "$(${SHLOG[_DATE_CMD]} --date="@${2}" -u +'%Y-%m-%dT%H:%M:%SZ')"
if [[ -n "${3}" ]]; then
    printf '%s ' "$(log_scopes_display)"
fi
color_reset

event_level_color "${4}"
printf '[%s] %s %s %s\n' "${5}" "${1}" "${6}" "${7}"
color_reset
