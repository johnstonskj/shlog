# -*- mode: sh; eval: (sh-set-shell "zsh") -*-

emulate -L zsh

local level=${1}; shift

if [[ ${level} -ge 1 && ${level} -le ${SHLOG_LEVEL} ]]; then
    # if currently specified level is larger than the last level,
    # reset it to a valid value.
    if [[ ${level} -gt ${SHLOG[_LEVEL_COUNT]} ]]; then
        level=${SHLOG[_LEVEL_COUNT]}
    fi

    level_name=$(event_level_name "${level}")

    level_icon=$(event_level_icon "${level}")

    local caller="${funcstack[2]}"
    if [[ "${caller}" == log_* ]]; then
        local caller="${funcstack[3]}"
    fi
    if [[ -n "${caller}" ]]; then
        caller=" $(basename ${caller}) ❱"
    fi

    formatter="${SHLOG_FORMATTER}"
    if ! whence -f "${formatter}" &> /dev/null; then
        formatter="log_formatter_default"
    fi

    $formatter              \
        "${caller}"         \
        "$(log_timestamp)"  \
        "${SHLOG[_SCOPES]}" \
        "$level"            \
        "$level_name"       \
        "$level_icon"       \
        "$*"
fi
